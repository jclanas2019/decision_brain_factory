{
  "version": 1,
  "industry": "Comercio: triaje de consultas y reclamaciones",
  "locale": "es_ES",
  "fields": [
    {
      "id": "dias_desde_compra",
      "type": "number",
      "description": "Días transcurridos desde la compra"
    },
    {
      "id": "mensaje",
      "type": "text",
      "description": "¿Cuál es la necesidad principal del cliente?"
    },
    {
      "id": "contexto",
      "type": "text",
      "description": "Organización y contexto operativo"
    }
  ],
  "decisions": [
    {
      "id": "clasificacion",
      "kind": "choice",
      "question": "¿Cuál es la necesidad principal del cliente?",
      "min_probability": 0.55,
      "options": [
        {
          "id": "consulta",
          "meaning": "Solicita información del producto."
        },
        {
          "id": "reclamacion",
          "meaning": "Reclama un problema con su compra."
        },
        {
          "id": "cancelacion",
          "meaning": "Expresa intención de cancelar la compra."
        }
      ]
    },
    {
      "id": "atencion_prioritaria",
      "kind": "boolean",
      "question": "¿El caso requiere atención prioritaria según los datos aportados?",
      "options": [
        {
          "id": "false",
          "meaning": "Se puede atender en el flujo habitual."
        },
        {
          "id": "true",
          "meaning": "Requiere revisión prioritaria."
        }
      ],
      "min_probability": 0.55
    },
    {
      "id": "nivel",
      "kind": "score",
      "question": "¿Qué nivel de atención corresponde al caso?",
      "options": [
        {
          "id": "bajo",
          "value": 0,
          "meaning": "Atención habitual."
        },
        {
          "id": "medio",
          "value": 1,
          "meaning": "Revisión del especialista."
        },
        {
          "id": "alto",
          "value": 2,
          "meaning": "Revisión humana prioritaria."
        }
      ],
      "min_probability": 0.5
    }
  ],
  "routing": {
    "review_action": "revision_humana",
    "fallback": "cola_general",
    "rules": [
      {
        "decision": "clasificacion",
        "option": "cancelacion",
        "min_probability": 0.6,
        "action": "revision_cancelacion"
      },
      {
        "decision": "clasificacion",
        "option": "reclamacion",
        "min_probability": 0.6,
        "action": "cola_postventa"
      },
      {
        "decision": "clasificacion",
        "option": "consulta",
        "min_probability": 0.6,
        "action": "cola_informacion"
      }
    ]
  },
