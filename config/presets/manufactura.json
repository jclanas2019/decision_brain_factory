{
  "version": 1,
  "industry": "Manufactura: triaje de reportes de calidad",
  "locale": "es_ES",
  "fields": [
    {
      "id": "desviacion_mm",
      "type": "number",
      "description": "Magnitud reportada de desviación dimensional"
    },
    {
      "id": "observacion",
      "type": "text",
      "description": "¿Qué condición describe el reporte de calidad?"
    },
    {
      "id": "contexto",
      "type": "text",
      "description": "Organización y contexto operativo"
    }
  ],
  "decisions": [
    {
      "id": "clasificacion",
      "kind": "choice",
      "question": "¿Qué condición describe el reporte de calidad?",
      "min_probability": 0.55,
      "options": [
        {
          "id": "conforme",
          "meaning": "No se reporta una desviación de calidad."
        },
        {
          "id": "inspeccion",
          "meaning": "Hay una desviación que requiere inspección."
        },
        {
          "id": "critico",
          "meaning": "El reporte describe una anomalía crítica para revisión."
        }
      ]
    },
    {
      "id": "atencion_prioritaria",
      "kind": "boolean",
      "question": "¿El caso requiere atención prioritaria según los datos aportados?",
      "options": [
        {
          "id": "false",
          "meaning": "Se puede atender en el flujo habitual."
        },
        {
          "id": "true",
          "meaning": "Requiere revisión prioritaria."
        }
      ],
      "min_probability": 0.55
    },
    {
      "id": "nivel",
      "kind": "score",
      "question": "¿Qué nivel de atención corresponde al caso?",
      "options": [
        {
          "id": "bajo",
          "value": 0,
          "meaning": "Atención habitual."
        },
        {
          "id": "medio",
          "value": 1,
          "meaning": "Revisión del especialista."
        },
        {
          "id": "alto",
          "value": 2,
          "meaning": "Revisión humana prioritaria."
        }
      ],
      "min_probability": 0.5
    }
  ],
  "routing": {
    "review_action": "revision_humana",
    "fallback": "cola_general",
    "rules": [
      {
        "decision": "clasificacion",
        "option": "critico",
        "min_probability": 0.6,
        "action": "revision_responsable"
      },
      {
        "decision": "clasificacion",
        "option": "inspeccion",
        "min_probability": 0.6,
        "action": "cola_inspeccion"
      },
      {
        "decision": "clasificacion",
        "option": "conforme",
        "min_probability": 0.6,
        "action": "registrar_conformidad"
      }
    ]
  },
